# ─── FanConnact Backend Environment (template) ──────────────────────
# Copy this file to `.env` (gitignored — never commit real keys) and
# fill in your values. Same vars go in Render -> Environment. 4 keys:
#   1. Cricket (match center)
#   2. All sports (non-cricket match data + live lists)
#   3. News
#   4. Reels (app only — website doesn't use this one)

# ── 1. CRICKET (RapidAPI "cricbuzz-cricket" package) ────────────────
CRICBUZZ_API_KEY=CHANGE_ME
CRICBUZZ_API_HOST=cricbuzz-cricket.p.rapidapi.com
CRICBUZZ_BASE_URL=https://cricbuzz-cricket.p.rapidapi.com

# ── 2. ALL SPORTS (allsportsapi2 + FlashLive — one shared key) ──────
ALLSPORTS_KEY=CHANGE_ME

# ── 3. NEWS (Currents API — primary news source) ────────────────────
CURRENTS_KEY=CHANGE_ME

# ── 4. REELS (Instagram reels — app only, website does not need it) ─
IG_KEY=CHANGE_ME

# ── Optional extras (only if you have them — leave blank otherwise) ─
CRICKET_KEY=
NEWSDATA_KEY=
FOOTBALL_KEY=
ODDS_KEY=
